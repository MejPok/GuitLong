<Page x:Class="GuitLong.Code.Parser.ParsePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GuitLong.Code.Parser"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ParsePage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="137*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Import New Song" FontSize="50" HorizontalAlignment="Center" Foreground="AntiqueWhite"/>

        <StackPanel Grid.Row="1" Margin="20, 0, 0, 0">
            <TextBlock Text="Enter URL:" HorizontalAlignment="Left" Foreground="AntiqueWhite"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="299*"/>
                    <ColumnDefinition Width="101*"/>
                </Grid.ColumnDefinitions>
                <TextBox Height="30" Text="https://tabs.ultimate-guitar.com/tab/radiohead/creep-chords-4169" Name="urlText" HorizontalAlignment="Left" MaxWidth="600" Width="600" Margin="10, 0, 10, 0" />
                <Button Content="Submit" MaxWidth="100" Height="30" Click="SubmitUrl" Grid.Column="1" Margin="0,5,0,5"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="20, 0, 0, 0">
            <TextBox
                Name="statusText"
                Text="Status:"
                IsReadOnly="True"
                BorderThickness="0"
                Background="Transparent"
                Foreground="AntiqueWhite"
                TextWrapping="Wrap"
                Padding="0"
                
            />

            <TextBlock Name="songName" Text="Name:" Foreground="AntiqueWhite"/>
            <TextBlock Name="songAuthor" Text="Author:" Foreground="AntiqueWhite"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Content="Convert to Song data" MaxWidth="150" Height="30" Click="ConvertSongData" Grid.Column="0" Grid.Row="0"/>
                <Button Content="Save Song" MaxWidth="150" Height="30" Click="SaveSong" Grid.Column="1" Grid.Row="0"/>

                <TextBlock Text="Custom Name:" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,10,0,0" Foreground="AntiqueWhite"/>
                <TextBox Name="nameInput" Width="400" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,10,0,0" Height="50"/>

                <TextBlock Text="Get url from this website: https://www.ultimate-guitar.com" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,100,0,0" Foreground="AntiqueWhite"/>
                <TextBox Text="Example url: https://tabs.ultimate-guitar.com/tab/radiohead/creep-chords-4169" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,120,0,0" Foreground="Black" IsReadOnly="True" />


            </Grid>

        </StackPanel>

    </Grid>
</Page>
